datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  FROZEN
}

enum KycLevel {
  UNVERIFIED
  BASIC
  STANDARD
  ENHANCED
  INSTITUTIONAL
}

enum KycStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  EXPIRED
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(6)

  profile      UserProfile?
  security     UserSecurity?
  sessions     UserSession[]
  devices      UserDevice[]
  events       SecurityEvent[]
  staffRoles   StaffRole[]
  kycApplications KycApplication[]
  accounts     Account[]
  orders       Order[]
  walletAddresses WalletAddress[]
  deposits        Deposit[]
  withdrawals     Withdrawal[]
}

model UserProfile {
  userId          String   @id @db.Uuid
  legalFirstName  String?  // Encrypted at rest
  legalLastName   String?  // Encrypted at rest
  dateOfBirth     DateTime? // Encrypted at rest
  country         String
  nationality     String?
  sourceOfFunds   String?
  expectedVolume  String?
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSecurity {
  userId             String    @id @db.Uuid
  mfaSecret          String?   // Encrypted at rest
  mfaEnabled         Boolean   @default(false)
  antiPhishingCode   String?
  passwordUpdatedAt  DateTime  @default(now()) @db.Timestamptz(6)
  lockoutUntil       DateTime? @db.Timestamptz(6)
  failedLoginAttempts Int       @default(0)

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserDevice {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  deviceFingerprint String
  userAgent         String
  ipAddress         String
  isTrusted         Boolean      @default(false)
  lastLoginAt       DateTime     @default(now()) @db.Timestamptz(6)

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          UserSession[]

  @@unique([userId, deviceFingerprint])
}

model UserSession {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @db.Uuid
  deviceId         String     @db.Uuid
  refreshTokenHash String     @unique
  isRevoked        Boolean    @default(false)
  expiresAt        DateTime   @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  device           UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String   @id
  description String
  roles       RolePermission[]
}

model Role {
  id          String   @id
  description String
  permissions RolePermission[]
  staff       StaffRole[]
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model StaffRole {
  userId String @db.Uuid
  roleId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model LoginAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  email       String
  ipAddress   String
  userAgent   String
  status      String   // e.g. SUCCESS, FAILED_CREDENTIALS, LOCKED_OUT
  attemptTime DateTime @default(now()) @db.Timestamptz(6)
}

model SecurityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  eventType   String   // e.g. MFA_DISABLED, PASSWORD_CHANGED, EMAIL_VERIFIED
  description String
  ipAddress   String
  eventTime   DateTime @default(now()) @db.Timestamptz(6)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycApplication {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  level          KycLevel
  status         KycStatus   @default(NOT_STARTED)
  reviewerId     String?     @db.Uuid
  reviewComments String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum OrderStatus {
  PENDING
  PARTIALLY_FILLED
  FILLED
  CANCELLED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

model Account {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  asset         String      // e.g. BTC, USDT
  type          AccountType @default(LIABILITY)
  balance       Decimal     @db.Decimal(36, 18) @default(0)
  lockedBalance Decimal     @db.Decimal(36, 18) @default(0)
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries LedgerEntry[]

  @@unique([userId, asset])
}

model LedgerTransaction {
  id          String      @id @default(uuid()) @db.Uuid
  description String
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  entries     LedgerEntry[]
}

model LedgerEntry {
  id            String          @id @default(uuid()) @db.Uuid
  transactionId String          @db.Uuid
  accountId     String          @db.Uuid
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(36, 18)
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)

  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  symbol         String      // e.g. BTC_USDT
  side           OrderSide
  type           OrderType
  price          Decimal     @db.Decimal(36, 18)
  quantity       Decimal     @db.Decimal(36, 18)
  filledQuantity Decimal     @db.Decimal(36, 18) @default(0)
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  buyTrades      Trade[]     @relation("BuyerOrder")
  sellTrades     Trade[]     @relation("SellerOrder")
}

model Trade {
  id            String   @id @default(uuid()) @db.Uuid
  symbol        String
  price         Decimal  @db.Decimal(36, 18)
  quantity      Decimal  @db.Decimal(36, 18)
  buyerId       String   @db.Uuid
  sellerId      String   @db.Uuid
  buyerOrderId  String   @db.Uuid
  sellerOrderId String   @db.Uuid
  makerFee      Decimal  @db.Decimal(36, 18)
  takerFee      Decimal  @db.Decimal(36, 18)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  buyerOrder    Order    @relation("BuyerOrder", fields: [buyerOrderId], references: [id], onDelete: Cascade)
  sellerOrder   Order    @relation("SellerOrder", fields: [sellerOrderId], references: [id], onDelete: Cascade)
}

model WalletAddress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  asset     String
  address   String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, asset])
}

model Deposit {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  asset         String
  address       String
  txHash        String   @unique
  amount        Decimal  @db.Decimal(36, 18)
  status        String
  confirmations Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  asset          String
  address        String
  amount         Decimal  @db.Decimal(36, 18)
  fee            Decimal  @db.Decimal(36, 18)
  status         String
  txHash         String?  @unique
  reviewComments String?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
