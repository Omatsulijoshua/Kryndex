# ==============================================================================
# Kryndex Exchange Environment Configuration Example
# Copy this file to .env in production and development environments.
# ==============================================================================

# Global Configuration
NODE_ENV=development
PORT=3000
API_GATEWAY_URL=http://localhost:3000
JWT_SECRET=super_secret_jwt_sign_key_should_be_long_and_complex_in_prod
JWT_REFRESH_SECRET=another_super_secret_jwt_refresh_sign_key_in_prod
MFA_ISSUER=Kryndex

# PostgreSQL Primary Transactional DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=kryndex_db_user
DB_PASSWORD=kryndex_secure_db_pass
DB_NAME=kryndex_exchange
DATABASE_URL=postgresql://kryndex_db_user:kryndex_secure_db_pass@localhost:5432/kryndex_exchange?schema=public

# Redis Cache, Lock & Session store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=kryndex_secure_redis_pass
REDIS_URL=redis://:kryndex_secure_redis_pass@localhost:6379/0

# ClickHouse Analytical DB
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=kryndex_ch_secure_pass
CLICKHOUSE_DATABASE=kryndex_market_data

# Apache Kafka Event Broker
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=kryndex-exchange
KAFKA_GROUP_ID=kryndex-services-group

# MinIO / S3 Object Storage for KYC Documents
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kryndex_s3_admin
S3_SECRET_KEY=kryndex_s3_secure_secret_key
S3_BUCKET_KYC=kryndex-kyc-documents

# Mailpit SMTP Mock Server
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@kryndex.com

# Matching Engine (Rust Service)
MATCHING_ENGINE_URL=http://localhost:50051
MATCHING_ENGINE_PORT=50051

# Security Settings
BCRYPT_ROUNDS=12
ARGON2_MEMORY_COST=16384
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
RATE_LIMIT_GLOBAL_TTL=60
RATE_LIMIT_GLOBAL_LIMIT=100
